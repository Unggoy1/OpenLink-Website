# Copy to .env.local for local dev. In production, set these in Vercel's
# project settings (Settings → Environment Variables) and redeploy.

# Password visitors type to get into the site.
# Leave unset (or empty) to turn the password gate off entirely.
SITE_PASSWORD=

# --- Downloads (private testing phase) ---
# Full http(s) URLs to each file on the file server. Any left blank show as
# "Not available yet" on the site. A malformed URL fails the build on purpose.
RELEASE_VERSION=
DOWNLOAD_CHECKSUMS_URL=
DOWNLOAD_APP_WINDOWS=
DOWNLOAD_CONNECTOR_WINDOWS=
DOWNLOAD_CONNECTOR_LINUX=
DOWNLOAD_HOSTAGENT_WINDOWS=
DOWNLOAD_DIRECTORY_WINDOWS=
DOWNLOAD_DIRECTORY_LINUX=
